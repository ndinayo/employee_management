DB_NAME=employee_management
DB_USER=employee_app
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional server-wide invitation email. Leave EMAIL_HOST blank to let each
# employer add their own Gmail App Password under Settings instead.
# For Gmail, use an App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=you@gmail.com

# Where invitation emails tell employees to sign in.
FRONTEND_URL=http://localhost:5173

# Used only by `python manage.py ensure_platform_admin` to create the initial
# platform super admin. Uncomment and replace all three with real values, then
# remove the password once the account exists.
# PLATFORM_ADMIN_USERNAME=your-admin-username
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
